# ---- Model providers: ONE key is enough to run. Order below is the default fallback chain. ----
# Groq — free, no credit card, does not train on your inputs. Start here: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini — https://aistudio.google.com . Free tier TRAINS ON YOUR INPUTS and is barred for EU/UK production.
# Enable billing for confidential client work; Flash costs cents.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic — required for connector tools (Higgsfield, Canva, Gmail, Slack, Drive) and native web search.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Breadth fallback. Free routes may train on inputs unless you disable training providers in OpenRouter settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free

# EU hosting, zero-retention option.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Cheap, not free. Data processed in China.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Override the fallback order (comma separated provider ids)
PROVIDER_CHAIN=

# ---- Web search for the Research Agent ----
# Tavily: 1,000 free searches/month, no card. Used whenever the serving model is not Anthropic. https://tavily.com
TAVILY_API_KEY=

# ---- Persistence (Upstash Redis / Vercel KV). Without these, projects are lost on redeploy. ----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Connector tokens (MCP OAuth bearers). These only work through the Anthropic provider. ----
HIGGSFIELD_MCP_TOKEN=
CANVA_MCP_TOKEN=
FIGMA_MCP_TOKEN=
SLACK_MCP_TOKEN=
GMAIL_MCP_TOKEN=
GDRIVE_MCP_TOKEN=
VERCEL_MCP_TOKEN=

GITHUB_TOKEN=
GITHUB_REPO=AtallaAbuTaha/joroots
