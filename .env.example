# ---- Model providers (at least one required) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---- Persistence (Upstash Redis / Vercel KV). Without these the app runs in-memory and says so. ----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Connectors via MCP (OAuth bearer tokens issued by each provider's MCP server) ----
HIGGSFIELD_MCP_TOKEN=
CANVA_MCP_TOKEN=
FIGMA_MCP_TOKEN=
SLACK_MCP_TOKEN=
GMAIL_MCP_TOKEN=
GDRIVE_MCP_TOKEN=
VERCEL_MCP_TOKEN=

# ---- Direct APIs ----
GITHUB_TOKEN=
GITHUB_REPO=owner/joroots-workforce

# ---- App ----
APP_PASSWORD=
